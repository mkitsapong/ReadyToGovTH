rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated();
    }

    // Public read access for job listings, write access restricted to authenticated admins
    match /jobs_live/{jobId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Public read access for books / exam prep resources, write access restricted to authenticated admins
    match /books_live/{bookId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
