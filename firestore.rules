rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // SECURITY: Check for admin custom claim instead of just authentication.
    // To set custom claims, use Firebase Admin SDK:
    //   admin.auth().setCustomUserClaims(uid, { admin: true })
    // If you haven't set up custom claims yet, you can temporarily use
    // email-based allowlist as a stopgap (uncomment below):
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // Alternative email-based allowlist (use ONLY as temporary stopgap):
    // function isAdmin() {
    //   return isAuthenticated() &&
    //     request.auth.token.email in ['your-admin@gmail.com'];
    // }

    // Public read access for job listings, write access restricted to verified admins
    match /jobs_live/{jobId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Public read access for books / exam prep resources, write access restricted to verified admins
    match /books_live/{bookId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── Analytics Validation Helpers ───────────────────────────────────────
    // Prevents data injection: caps document field count and restricts allowed fields.
    function isValidAnalyticsWrite() {
      let d = request.resource.data;
      return d.size() <= 30
          && (d.keys().hasAny([
            'date', 'views', 'count', 'query', 'jobId', 'timestamp',
            'pageviews', 'totalPageviews', 'lastUpdated', 'lastViewed',
            'applies', 'totalApplies', 'shares', 'bookmarks', 'pdfViews',
            'department', 'visitors'
          ]));
    }

    // Guards string fields from being excessively long (spam prevention).
    function isValidSearchWrite() {
      let d = request.resource.data;
      return d.size() <= 15
          && (d.keys().hasAny(['query', 'count', 'timestamp', 'lastSearched']))
          && (!('query' in d) || (d.query is string && d.query.size() <= 200));
    }

    // Analytics: Daily statistics (public create/update for live counter increments)
    match /analytics_daily/{dateId} {
      allow read: if true;
      allow create, update: if isValidAnalyticsWrite();
      allow delete: if isAdmin();
    }

    // Analytics: Job views & engagement counters
    match /analytics_jobs/{jobId} {
      allow read: if true;
      allow create, update: if isValidAnalyticsWrite();
      allow delete: if isAdmin();
    }

    // Analytics: Real user search keywords
    match /analytics_searches/{searchId} {
      allow read: if true;
      allow create, update: if isValidSearchWrite();
      allow delete: if isAdmin();
    }

    // Analytics: Overall aggregated summary counters
    match /analytics_summary/{docId} {
      allow read: if true;
      allow create, update: if isValidAnalyticsWrite();
      allow delete: if isAdmin();
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
